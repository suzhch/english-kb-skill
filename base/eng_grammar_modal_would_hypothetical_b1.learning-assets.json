    },
    {
      "id": "asset_eng_grammar_modal_would_hypothetical_b1_counter_condition",
      "knowledgePointId": "eng_grammar_modal_would_hypothetical_b1",
      "strategy": "COUNTER_EXAMPLE",
      "title": "Wrong tense in the if-clause",
      "createdAt": "2026-08-14T10:00:00+09:00",
      "updatedAt": null,
      "counterExample": {
        "wrong": "If I have more time, I would learn to play the guitar.",
        "reason": "非真实条件句的 if 从句不能用一般现在时。正确说法是 If I had more time, I would learn to play the guitar.（从句用过去式，主句用 would）"
      }
    },
    {
      "id": "asset_eng_grammar_modal_would_hypothetical_b1_counter_will",
      "knowledgePointId": "eng_grammar_modal_would_hypothetical_b1",
      "strategy": "COUNTER_EXAMPLE",
      "title": "Will instead of would",
      "createdAt": "2026-08-14T10:00:00+09:00",
      "updatedAt": null,
      "counterExample": {
        "wrong": "If I were you, I will ask the teacher.",
        "reason": "这是与现在事实相反的非真实条件句，主句应使用 would 而不是 will。正确说法是 If I were you, I would ask the teacher."
      }
    },
    {
      "id": "asset_eng_grammar_modal_would_hypothetical_b1_confusion_request",
      "knowledgePointId": "eng_grammar_modal_would_hypothetical_b1",
      "strategy": "CONFUSION",
      "title": "Would vs could in polite requests",
      "createdAt": "2026-08-14T10:00:00+09:00",
      "updatedAt": null,
      "confusion": {
        "confusedWith": "would and could in polite requests",
        "reason": "Would you...? 和 Could you...? 都用于礼貌请求，但 Would you...? 侧重询问对方意愿（你愿意……吗），Could you...? 侧重询问能力或可能性（你能……吗）。请求对方做事时两者都常用，但含义侧重不同。"
      }
    },
    {
      "id": "asset_eng_grammar_modal_would_hypothetical_b1_scenario_advice",
      "knowledgePointId": "eng_grammar_modal_would_hypothetical_b1",
      "strategy": "SCENARIO",
      "title": "Giving advice about trying something new",
      "createdAt": "2026-08-14T10:00:00+09:00",
      "updatedAt": null,
      "scenario": {
        "description": "朋友担心自己会失败，不敢尝试新事物。你给他建议：If I were you, I would try it once.（如果我是你，我会先试一次。）再设想：If she came tomorrow, we would study together.（如果她明天来，我们会一起复习。）这些场景都用 would 表达假设情况下的行动。"
      }
    },
    {
