  "assets": [
    {
      "id": "asset_eng_grammar_modal_would_hypothetical_b1_classification",
      "knowledgePointId": "eng_grammar_modal_would_hypothetical_b1",
      "strategy": "CLASSIFICATION",
      "title": "Grammar category",
      "createdAt": "2026-08-14T10:00:00+09:00",
      "updatedAt": null,
      "classification": {
        "parent": "Hypothetical and conditional expressions",
        "reason": "would 属于情态动词，用于表达假设、虚拟或委婉语气，是 B1 阶段条件句和假设表达的核心动词。文中 I wouldn’t forgive me either. 用 wouldn’t 描述“换作是我”的假设行为。"
      }
    },
    {
      "id": "asset_eng_grammar_modal_would_hypothetical_b1_explanation",
      "knowledgePointId": "eng_grammar_modal_would_hypothetical_b1",
      "strategy": "EXPLANATION",
      "title": "Core rule",
      "createdAt": "2026-08-14T10:00:00+09:00",
      "updatedAt": null,
      "explanation": {
        "myUnderstanding": "would 表示假设或虚拟的情况，常与 if 从句搭配：if 从句用过去式，主句用 would + 动词原形。它也用于委婉请求，如 Would you...?。否定式 wouldn’t 表示“不会（那样做）”。确定会发生的将来用 will，不用 would。"
      }
    },
    {
      "id": "asset_eng_grammar_modal_would_hypothetical_b1_comparison",
      "knowledgePointId": "eng_grammar_modal_would_hypothetical_b1",
      "strategy": "COMPARISON",
      "title": "Will vs would",
      "createdAt": "2026-08-14T10:00:00+09:00",
      "updatedAt": null,
      "comparison": {
        "compareWith": "will and would",
        "similarities": [
          "两者都是情态动词，后接动词原形，不随主语变化。",
          "两者都可以用于提出请求或询问意愿。",
          "两者都可以出现在条件句的主句中。"
        ],
        "differences": [
          "will 表示确定的将来、打算或承诺；would 表示假设、虚拟或更委婉的语气。",
          "真实条件句用 if + 一般现在时 + will；非真实假设用 if + 过去式 + would。",
          "Would you...? 比 Will you...? 更委婉、更礼貌。"
        ]
      }
    },
    {
      "id": "asset_eng_grammar_modal_would_hypothetical_b1_association",
      "knowledgePointId": "eng_grammar_modal_would_hypothetical_b1",
      "strategy": "ASSOCIATION",
      "title": "Common chunks",
      "createdAt": "2026-08-14T10:00:00+09:00",
      "updatedAt": null,
      "association": {
        "relatedTopics": [
          "eng_grammar_modal_will_future_a2",
          "eng_grammar_modal_could_a2",
          "eng_grammar_conditionals_b1"
        ],
        "relatedWords": [
          "would like to",
          "would love to",
          "would rather",
          "would you mind",
          "if I were you",
          "wouldn't",
          "I'd"
        ],
        "note": "先记住这些高频词组（would like to、would rather、would you mind），再理解 would 的“假设”核心含义。"
      }
    },
    {
      "id": "asset_eng_grammar_modal_would_hypothetical_b1_example_hypothetical",
      "knowledgePointId": "eng_grammar_modal_would_hypothetical_b1",
      "strategy": "EXAMPLE",
      "title": "Hypothetical statement",
      "createdAt": "2026-08-14T10:00:00+09:00",
      "updatedAt": null,
      "example": {
        "english": "If I had more time, I would learn to play the guitar.",
        "translation": "如果我有更多时间，我会学弹吉他。",
        "note": "if 从句用过去式 had，主句用 would + 动词原形，表示与现在事实相反的假设。"
      }
    },
    {
      "id": "asset_eng_grammar_modal_would_hypothetical_b1_example_zootopia",
