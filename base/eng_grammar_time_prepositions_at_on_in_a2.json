  "definition": {
    "name": "Time Prepositions: at, on, in",
    "description": "Use 'at', 'on', and 'in' before time words. Use 'at' for exact times and some fixed time expressions, 'on' for days and dates, and 'in' for months, years, seasons, and longer periods."
  },
  "examples": [
    {
      "english": "I get up at 7:00.",
      "translation": "我七点起床。",
      "note": "Use 'at' with an exact clock time."
    },
    {
      "english": "The party is on Saturday.",
      "translation": "聚会在星期六。",
      "note": "Use 'on' with days of the week."
    },
    {
      "english": "My birthday is on May 5th.",
      "translation": "我的生日在五月五日。",
      "note": "Use 'on' with exact dates."
    },
    {
      "english": "School starts in September.",
      "translation": "学校九月开学。",
      "note": "Use 'in' with months."
    },
    {
      "english": "We went there in 2025.",
      "translation": "我们在2025年去了那里。",
      "note": "Use 'in' with years."
    },
    {
      "english": "It is cold in winter.",
      "translation": "冬天很冷。",
      "note": "Use 'in' with seasons."
    }
  ],
  "expressions": [
